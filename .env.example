# Database (async SQLAlchemy). Postgres must be running before alembic / app (e.g. docker compose up -d).
DATABASE_URL=postgresql+asyncpg://llmchat:llmchat@localhost:5432/llmchat

# Redis (refresh tokens + optional message cache)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# GitHub OAuth (create app at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# LLM (place model.gguf in project root or set path)
LLM_MODEL_PATH=./models/Llama-3.2-3B-Instruct-Q4_K_M.gguf
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.7
LLM_CONTEXT_MESSAGES=10

# CORS (comma-separated origins for SPA)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
